---
import { Code } from "astro:components";
import type { ShikiTransformer } from "shiki";

type SupportedCodeLanguage = "bibtex" | "latex" | "plaintext";

interface Props {
  code: string;
  copyLabel?: string;
  lang?: SupportedCodeLanguage;
}

const { code, copyLabel = "Copy", lang = "plaintext" } = Astro.props as Props;
const codeId = `copyable-code-${crypto.randomUUID()}`;
const buttonId = `copyable-code-button-${crypto.randomUUID()}`;

const preClass =
  "relative m-0 overflow-hidden rounded-lg border border-stone-300 bg-stone-100 text-sm leading-relaxed text-stone-800 shadow-sm";
const codeClass = "block max-w-full overflow-x-auto p-4 pr-24";
const buttonClass =
  "absolute right-3 top-3 z-20 inline-flex min-w-16 items-center justify-center rounded-full border border-stone-300 bg-white/95 px-3 py-1.5 text-xs font-medium text-stone-800 shadow-sm backdrop-blur transition-colors hover:border-stone-950 hover:bg-stone-950 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900";

const mergeClasses = (classValue: unknown, className: string): string => {
  const existing = Array.isArray(classValue) ? classValue.join(" ") : typeof classValue === "string" ? classValue : "";
  return [existing, className].filter(Boolean).join(" ");
};

const copyButtonTransformer = {
  pre(node) {
    const properties = (node.properties ??= {});

    properties.class = mergeClasses(properties.class ?? properties.className, preClass);
    delete properties.className;
    delete properties.style;
    node.children.unshift({
      type: "element",
      tagName: "button",
      properties: {
        id: buttonId,
        type: "button",
        "aria-controls": codeId,
        class: buttonClass,
        "data-copy-label": copyLabel,
        "data-copy-target": codeId,
        "data-copyable-code-button": "",
      },
      children: [{ type: "text", value: copyLabel }],
    });
  },
  code(node) {
    const properties = (node.properties ??= {});

    properties.id = codeId;
    properties.class = mergeClasses(properties.class ?? properties.className, codeClass);
    delete properties.className;
  },
} satisfies ShikiTransformer;
---

<div class="not-prose my-6">
  <Code code={code} lang={lang} theme="one-light" transformers={[copyButtonTransformer]} />
</div>

<script>
  const selectCodeText = (codeBlock: HTMLElement) => {
    const selection = window.getSelection();
    const range = document.createRange();

    selection?.removeAllRanges();
    range.selectNodeContents(codeBlock);
    selection?.addRange(range);
  };

  document.querySelectorAll("[data-copyable-code-button]").forEach((element) => {
    if (!(element instanceof HTMLButtonElement) || element.dataset.copyReady === "true") {
      return;
    }

    element.dataset.copyReady = "true";

    element.addEventListener("click", async () => {
      const codeTarget = element.dataset.copyTarget;
      const codeBlock = codeTarget ? document.getElementById(codeTarget) : null;
      const text = codeBlock?.textContent ?? "";
      const initialLabel = element.dataset.copyLabel ?? "Copy";

      try {
        if (!navigator.clipboard?.writeText) {
          throw new Error("Clipboard API unavailable");
        }

        await navigator.clipboard.writeText(text);
        element.textContent = "Copied";
      } catch {
        if (codeBlock) {
          selectCodeText(codeBlock);
        }
        element.textContent = "Select";
      }

      window.setTimeout(() => {
        element.textContent = initialLabel;
      }, 1600);
    });
  });
</script>
