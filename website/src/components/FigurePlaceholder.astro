---
interface Props {
  title: string;
  caption: string;
  eyebrow?: string;
  size?: "standard" | "wide";
  class?: string;
}

const {
  title,
  caption,
  eyebrow = "Figure slot",
  size = "standard",
  class: className,
} = Astro.props as Props;

const widthClass = size === "wide" ? "max-w-3xl" : "max-w-xl";
---

<figure class:list={["not-prose my-8", className]}>
  <div
    class:list={[
      "mx-auto flex aspect-[16/9] w-full flex-col items-center justify-center rounded-lg border border-dashed border-stone-300 bg-white px-6 text-center shadow-sm",
      widthClass,
    ]}
  >
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-400">{eyebrow}</p>
    <p class="mt-3 max-w-md text-sm font-medium leading-relaxed text-stone-800">{title}</p>
    <div class="mt-5 grid w-full max-w-sm grid-cols-3 gap-2" aria-hidden="true">
      <span class="h-2 rounded-full bg-stone-200"></span>
      <span class="h-2 rounded-full bg-stone-300"></span>
      <span class="h-2 rounded-full bg-stone-200"></span>
    </div>
  </div>
  <figcaption class="mx-auto mt-3 max-w-2xl text-center text-sm leading-relaxed text-stone-500">
    {caption}
  </figcaption>
</figure>
