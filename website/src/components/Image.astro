---
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { thumbhashHexToDataUrl } from "../lib/thumbhashPlaceholder";

type ImageSource = string | ImageMetadata;

interface Props {
  src: ImageSource;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  class?: string;
  size?: "narrow" | "standard" | "wide" | "text";
  thumbhash?: string;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "high" | "low" | "auto";
  quality?: number;
  loadOnView?: boolean;
}

const {
  src,
  alt,
  caption,
  width,
  height,
  class: className,
  size = "standard",
  thumbhash,
  loading,
  decoding,
  fetchpriority,
  quality,
  loadOnView = false,
} = Astro.props as Props;

const isOptimizable = typeof src === "object" && src !== null && "src" in src;
const shouldLoadOnView = loadOnView && !isOptimizable;

const imageMetadata = isOptimizable ? (src as ImageMetadata) : undefined;
const resolvedWidth = width ?? imageMetadata?.width;
const resolvedHeight = height ?? imageMetadata?.height;
const placeholderDataUrl = thumbhash ? thumbhashHexToDataUrl(thumbhash) : undefined;
const transparentImageDataUrl =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E";

const mediaShellStyle =
  (placeholderDataUrl || shouldLoadOnView) && resolvedWidth != null && resolvedHeight != null
    ? `aspect-ratio: ${resolvedWidth} / ${resolvedHeight};`
    : undefined;

const placeholderShellId = placeholderDataUrl ? `thumbhash-${crypto.randomUUID()}` : undefined;
const baseImageClass = "relative z-10 block h-auto w-full";
const mainImageClass = placeholderDataUrl
  ? `${baseImageClass} opacity-0 transition-opacity duration-500`
  : baseImageClass;
const mediaSizeClassByPreset = {
  narrow: "md:max-w-sm lg:max-w-md",
  standard: "md:max-w-lg lg:max-w-xl",
  wide: "md:max-w-xl lg:max-w-2xl",
  text: "max-w-none",
} as const;
const mediaShellClass = `relative mx-auto w-full overflow-hidden ${mediaSizeClassByPreset[size]}`;
const mainImageOnLoad = placeholderDataUrl
  ? "this.classList.add('opacity-100');this.closest('[data-thumbhash-shell]')?.classList.add('is-loaded');"
  : undefined;
---

<figure class:list={["not-prose my-8", className]}>
  <div
    class={mediaShellClass}
    style={mediaShellStyle}
    id={placeholderShellId}
    data-thumbhash-shell
  >
    {
      placeholderDataUrl && (
        <img
          src={placeholderDataUrl}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 size-full scale-[1.02] object-cover transition-opacity duration-300"
          data-thumbhash-preview
        />
      )
    }
    {
      isOptimizable ? (
        <AstroImage
          src={src as ImageMetadata}
          alt={alt}
          width={resolvedWidth}
          height={resolvedHeight}
          layout="constrained"
          class={mainImageClass}
          loading={loading}
          decoding={decoding}
          fetchpriority={fetchpriority}
          quality={quality}
          onload={mainImageOnLoad}
          data-main-image
        />
      ) : (
        <img
          src={shouldLoadOnView ? transparentImageDataUrl : (src as string)}
          data-src={shouldLoadOnView ? (src as string) : undefined}
          alt={alt}
          width={resolvedWidth}
          height={resolvedHeight}
          class={mainImageClass}
          loading={loading ?? "lazy"}
          decoding={decoding ?? "async"}
          fetchpriority={fetchpriority}
          onload={mainImageOnLoad}
          data-main-image
          data-load-on-view-image={shouldLoadOnView ? "true" : undefined}
        />
      )
    }
  </div>
  {
    caption && (
      <figcaption class="mt-3 text-center text-sm leading-relaxed text-stone-500">
        {caption}
      </figcaption>
    )
  }
  {
    placeholderDataUrl && placeholderShellId && (
      <script is:inline define:vars={{ placeholderShellId }}>
        requestAnimationFrame(() => {
          const root = document.getElementById(placeholderShellId);
          const mainImage = root?.querySelector("[data-main-image]");
          if (mainImage instanceof HTMLImageElement && mainImage.complete) {
            mainImage.classList.add("opacity-100");
            root.classList.add("is-loaded");
          }
        });
      </script>
    )
  }
  {
    shouldLoadOnView && (
      <noscript>
        <img
          src={src as string}
          alt={alt}
          width={resolvedWidth}
          height={resolvedHeight}
          class={baseImageClass}
          loading={loading ?? "lazy"}
          decoding={decoding ?? "async"}
        />
      </noscript>
    )
  }
</figure>

<script>
  const loadDeferredImage = (image: HTMLImageElement) => {
    const deferredSrc = image.dataset.src;
    if (!deferredSrc || image.dataset.loadedOnView === "true") {
      return;
    }

    image.dataset.loadedOnView = "true";
    image.src = deferredSrc;
  };

  const deferredImages = Array.from(document.querySelectorAll("[data-load-on-view-image]")).filter(
    (image): image is HTMLImageElement => image instanceof HTMLImageElement,
  );

  if ("IntersectionObserver" in window) {
    const imageObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target instanceof HTMLImageElement) {
            loadDeferredImage(entry.target);
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
    );

    deferredImages.forEach((image) => {
      if (image.dataset.loadedOnView !== "true") {
        imageObserver.observe(image);
      }
    });
  } else {
    deferredImages.forEach(loadDeferredImage);
  }
</script>

<style>
  [data-thumbhash-shell].is-loaded [data-thumbhash-preview] {
    opacity: 0;
  }
</style>
